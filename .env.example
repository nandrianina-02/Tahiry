# URL de connexion MongoDB (Atlas ou local)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/tahiry

# Clé secrète pour signer les tokens JWT (mets une longue chaîne aléatoire en prod)
JWT_SECRET=change-moi-en-une-chaine-longue-et-aleatoire

# Port du serveur
PORT=3000

# Origine autorisée pour le frontend si servi séparément (sinon laisse vide,
# le serveur sert le index.html lui-même en same-origin)
CLIENT_ORIGIN=

# "production" active les cookies Secure (nécessite HTTPS)
NODE_ENV=development

# URL publique de l'application (utilisée dans le lien de réinitialisation de mot de passe)
# Laisse vide pour que le serveur déduise l'URL automatiquement depuis la requête.
APP_URL=

# Envoi d'email pour "mot de passe oublié" (facultatif — si absent, le lien est
# juste affiché dans les logs du serveur, utile en développement).
# Exemple avec Gmail : crée un "mot de passe d'application" sur ton compte Google
# (https://myaccount.google.com/apppasswords), ce n'est PAS ton mot de passe normal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
